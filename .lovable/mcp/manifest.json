            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Clothing category, e.g. tops, bottoms, dresses, shoes"
            },
            "name": {
              "type": "string",
              "description": "Optional display name for the item"
            },
            "brand": {
              "type": "string",
              "description": "Optional brand name"
            },
            "color": {
              "type": "string",
